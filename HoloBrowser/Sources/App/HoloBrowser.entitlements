<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound network access required for web browsing and AI provider streaming -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- network.server removed: a browser does not accept incoming connections.
         This was an unnecessary entitlement that expanded attack surface. -->

    <!-- Hardware device access for WebRTC / media capture on web pages -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.microphone</key>
    <true/>

    <!-- Print support -->
    <key>com.apple.security.print</key>
    <true/>

    <!-- ~/Downloads read-write: required for WKDownloadDelegate to write files.
         Without this entitlement the sandbox blocks all download destinations
         and every WKDownload silently fails in production builds. -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- User-selected file access: required for file upload dialogs and import wizards -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
